---
import "../styles/blog.css";
import { getPublishedPages } from "../lib/content";

// 独立页面（关于等）自动进入导航。
const pages = await getPublishedPages();

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  ogType?: "website" | "article";
  ogImage?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
}

const {
  title,
  description,
  canonical,
  noindex = false,
  ogType = "website",
  ogImage,
  publishedTime,
  modifiedTime,
  author,
} = Astro.props;
const site = Astro.site ?? new URL("https://example.com");
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, site);
const rssUrl = new URL("/rss.xml", site).href;
const fullTitle = title === "Woo3aN's Blog" ? title : `${title} · Woo3aN's Blog`;
const ogImageUrl = ogImage ? new URL(ogImage, site).href : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Woo3aN's Blog" href={rssUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Woo3aN's Blog" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogType === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === "article" && author && <meta property="article:author" content={author} />}
    <meta name="twitter:card" content={ogImageUrl ? "summary_large_image" : "summary"} />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <a class="site-brand" href="/">Woo3aN's Blog</a>
      <nav class="site-nav" aria-label="站点导航">
        <a href="/archive/">归档</a>
        <a href="/categories/">分类</a>
        <a href="/tags/">标签</a>
        <a href="/search/">搜索</a>
        <!-- 独立页面（关于等）与归档/分类/标签/搜索同级，新增页面自动出现在这里。
             RSS 入口先撤了：/rss.xml 仍然存在，需要时再加回来。 -->
        {pages.map((page) => <a href={page.data.path}>{page.data.title}</a>)}
        <a href="/lab/">三维档案</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getUTCFullYear()} Woo3aN · 由 Markdown 与 Astro 生成</p>
    <!-- 备案信息（按需填写）：若站点在中国大陆备案，可在此处放回工信部备案号与公安备案号。
         本模板默认不包含任何备案号与备案图标。 -->
    </footer>
  </body>
</html>
